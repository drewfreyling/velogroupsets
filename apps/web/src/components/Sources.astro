---
import ExternalLink from './ExternalLink.astro';
const { sources } = Astro.props;
---
<section class="mt-10 border-t border-line pt-7" aria-label="Sources">
  <h2 class="mb-5 text-2xl">Sources</h2>
  <ul class="space-y-3 text-sm">{sources.map(s => <li><ExternalLink class="text-link" href={s.url}>{s.title}</ExternalLink>{s.retrieved_on && <span class="ml-3 text-muted">Accessed {s.retrieved_on}</span>}</li>)}</ul>
</section>
