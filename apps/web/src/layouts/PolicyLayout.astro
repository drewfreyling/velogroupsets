---
import Layout from './Layout.astro';
import { operator, contactEmail, policiesReady } from '../lib/policy.mjs';
import { POLICY_VERSION } from '../../../../packages/shared/community';
const {title}=Astro.props;
---
<Layout title={title}>
  <article class="wrap max-w-3xl py-12">
    <h1 class="text-4xl font-semibold">{title}</h1>
    <p class="mt-4 text-sm text-muted">Policy version {POLICY_VERSION} · Updated 8 November 2026</p>
    {!policiesReady && <p class="panel mt-6 p-5" role="note"><strong>Draft policies.</strong> Photo uploads are not open while the operator and monitored contact details are being configured.</p>}
    <div class="policy-copy mt-8 space-y-6 leading-7"><slot /></div>
    <section class="mt-10 border-t border-line pt-6" aria-label="Policy contact">
      <h2 class="text-2xl font-semibold">Contact</h2>
      {policiesReady ? <p class="mt-3">Site operator: {operator}. For privacy, copyright, takedown or account requests, email <a class="text-link" href={`mailto:${contactEmail}`}>{contactEmail}</a>. Include the relevant photo or page URL; please do not attach suspected illegal material.</p> : <p class="mt-3 text-muted">Operator identity and monitored email address are awaiting confirmation. This draft is not an invitation to upload content.</p>}
    </section>
    <nav class="mt-8 flex flex-wrap gap-5 text-sm" aria-label="Related policies">
      <a class="text-link" href="/policies/terms/">Terms of Service</a><a class="text-link" href="/policies/privacy/">Privacy Policy</a><a class="text-link" href="/policies/community/">Community Guidelines</a><a class="text-link" href="/policies/copyright/">Copyright and takedowns</a>
    </nav>
  </article>
</Layout>
