---
import ExternalLink from '../components/ExternalLink.astro';
import '../styles/global.css';
const { title = 'Bicycle groupset and component specifications', description = 'Specifications for bicycle groupsets and components, each linked to its source.', noindex = false } = Astro.props;
const staging = import.meta.env.SITE.includes('staging.') || import.meta.env.SITE.includes('localhost');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · VeloGroupsets</title>
    <meta name="description" content={description} />
    {(staging || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4" href="#main">Skip to content</a>
    <header class="border-b border-line">
      <div class="wrap flex min-h-22 flex-wrap items-center justify-between gap-4 py-5">
        <a href="/" aria-label="VeloGroupsets home" class="flex items-center gap-3 text-xl font-bold tracking-tight">
          <svg class="size-9" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="17" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="20" r="5" stroke="currentColor" stroke-width="2"/><path d="m20 15 9-9M25 20h12M20 25l-9 9M15 20H3" stroke="currentColor" stroke-width="2"/></svg>
          Velo<span class="-ml-3 font-normal">Groupsets</span>
        </a>
        <nav aria-label="Main navigation" class="flex items-center gap-5 text-sm sm:gap-8">
          <a href="/manufacturers/" class="hover:underline">Manufacturers</a>
          <a href="/catalogue/" class="hover:underline">Catalogue</a>
          <ExternalLink href="https://github.com/drewfreyling/velogroupsets/blob/main/docs/catalogue.md" class="hidden items-center gap-2 font-semibold sm:flex">Add a missing part</ExternalLink>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="mt-20 border-t border-line py-8">
      <div class="wrap flex flex-col justify-between gap-5 text-sm text-muted sm:flex-row">
        <p>An independent catalogue of bicycle groupsets and components.</p>
        <div class="flex gap-6"><ExternalLink class="text-link" href="https://github.com/drewfreyling/velogroupsets">Source code on GitHub</ExternalLink><ExternalLink class="text-link" href="https://github.com/drewfreyling/velogroupsets/blob/main/docs/catalogue.md">Contribution guide</ExternalLink></div>
      </div>
    </footer>
  </body>
</html>
