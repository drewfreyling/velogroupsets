---
import Layout from '../layouts/Layout.astro';
import ComponentList from '../components/ComponentList.astro';
import { manufacturers, groupsets, components, types, manufacturerUrl } from '../lib/catalogue.mjs';
---
<Layout>
  <section class="wrap grid gap-10 py-14 md:grid-cols-[1.3fr_1fr] md:items-center md:py-22">
    <div>
      <p class="eyebrow mb-6 flex items-center gap-2"><span class="size-2 rounded-full bg-ink"></span> The open bicycle component reference</p>
      <h1 class="max-w-2xl text-5xl leading-[1.05] font-medium tracking-[-0.045em] sm:text-7xl">Every groupset.<br/>Every little detail.</h1>
      <p class="mt-7 max-w-lg text-lg leading-8 text-muted">Find the parts. Follow the sources. Explore the components that make a bicycle your own.</p>
      <div class="mt-8 flex flex-wrap items-center gap-5"><a class="button" href="/catalogue/">Explore the catalogue <span aria-hidden="true"><svg class="inline-block size-4 shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a><a class="text-link text-sm" href="/manufacturers/">Browse manufacturers</a></div>
      <p class="mt-8 text-xs text-muted">An early catalogue, built one sourced record at a time.</p>
    </div>
    <div class="relative flex aspect-square max-h-104 items-center justify-center overflow-hidden rounded-3xl bg-[#e5e8de]" aria-hidden="true">
      <svg viewBox="0 0 400 400" class="size-full p-7" fill="none">
        <defs><pattern id="grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" stroke="#cbd2c3" stroke-width=".5"/></pattern></defs>
        <path fill="url(#grid)" d="M0 0h400v400H0z"/>
        <circle cx="200" cy="195" r="132" stroke="#a4b19d" stroke-dasharray="4 6"/>
        <g stroke="#27372d" stroke-width="2"><circle cx="200" cy="195" r="106"/><circle cx="200" cy="195" r="94" stroke-width="12" stroke-dasharray="2 7"/><circle cx="200" cy="195" r="78"/><circle cx="200" cy="195" r="50"/>
          <path d="m200 180 55-53 24 34-64 45 15 130-28 3-20-127-69-47 22-33 55 48Z" fill="#344839"/>
          <circle cx="200" cy="195" r="21" fill="#e5e8de"/><circle cx="200" cy="195" r="9"/><circle cx="214" cy="326" r="6" fill="#e5e8de"/>
        </g>
        <path d="M50 63h48M74 39v48M315 300h48M339 276v48" stroke="#7b8c73"/>
      </svg>
      <span class="absolute bottom-5 left-6 font-mono text-[10px] tracking-widest text-muted">FIG. 01 — THE DRIVETRAIN</span>
      <span class="absolute top-5 right-6 rounded-full border border-[#b5c2a9] px-3 py-1 text-[10px] uppercase tracking-widest">Built to explore</span>
    </div>
  </section>
  <section class="border-y border-line bg-white/35 py-6">
    <div class="wrap grid grid-cols-3 gap-4">{[[manufacturers.length,'Manufacturers'],[groupsets.length,'Groupsets'],[components.length,'Components']].map(([count,label]) => <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-3"><strong class="text-3xl font-medium tabular-nums">{count}</strong><span class="text-xs text-muted sm:text-sm">{label} catalogued</span></div>)}</div>
  </section>
  <section class="wrap pt-14">
    <div class="mb-7 flex items-end justify-between gap-4"><div><p class="eyebrow mb-3">Start with the maker</p><h2 class="text-3xl tracking-tight">Browse manufacturers</h2></div><a class="text-link shrink-0 whitespace-nowrap text-sm" href="/manufacturers/">View all <svg class="inline-block size-4 shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div>
    <div class="grid gap-4 sm:grid-cols-3">{manufacturers.map(m => <a href={manufacturerUrl(m)} class="panel group flex items-center justify-between p-7"><div><h3 class="text-2xl font-semibold tracking-tight">{m.name}</h3><p class="mt-3 text-sm text-muted">{groupsets.filter(g=>g.manufacturer_id===m.id).length} groupset catalogued</p></div><span class="group-hover:translate-x-1" aria-hidden="true"><svg class="inline-block size-4 shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></span></a>)}
      <div class="rounded-2xl border border-dashed border-line p-7 sm:col-span-2"><h3 class="font-semibold">Your knowledge belongs here.</h3><p class="mt-2 max-w-lg text-sm leading-6 text-muted">Vintage or current, familiar or hard to find. Help grow the reference with a sourced manufacturer, groupset or component.</p><a class="text-link mt-4 inline-block text-sm" href="https://github.com/drewfreyling/velogroupsets/blob/main/docs/catalogue.md">Add to the catalogue <svg class="inline-block size-4 shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div>
    </div>
  </section>
  <section class="wrap pt-14"><div class="mb-7 flex items-end justify-between gap-4"><div><p class="eyebrow mb-3">Inside the catalogue</p><h2 class="text-3xl tracking-tight">Components to explore</h2></div><a class="text-link shrink-0 whitespace-nowrap text-sm" href="/catalogue/">View all <svg class="inline-block size-4 shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div><ComponentList records={components.slice(0,4)} /></section>
  <section class="wrap pt-14"><h2 class="eyebrow mb-5">Find your component type</h2><div class="flex flex-wrap gap-2">{types.map(t=><a class="rounded-full border border-line px-4 py-2 text-sm hover:bg-accent" href={`/catalogue/?type=${t.const}`}>{t.title}</a>)}</div></section>
</Layout>
