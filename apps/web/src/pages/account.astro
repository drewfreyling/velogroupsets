---
import Layout from '../layouts/Layout.astro';
import { POLICY_VERSION } from '../../../../packages/shared/community';
import { communityEnabled } from '../lib/features.mjs';
if (!communityEnabled) return Astro.redirect('/catalogue/', 302);
---
<Layout title="Your account" noindex>
  <div class="wrap max-w-3xl py-12"><h1 class="text-4xl font-semibold">Your account</h1>
    <p class="mt-4 leading-7 text-muted">Sign in with Google to submit component photos. Your Google email stays private; only your chosen display name appears with approved photos.</p>
    <p id="account-message" class="mt-6" role="status">Checking sign-in availability…</p>
    <form id="sign-in-form" method="post" action="/api/auth/google/start" class="panel mt-8 space-y-5 p-6" hidden>
      <label class="block">Public display name <span class="text-sm text-muted">(for a new account; optional)</span><input class="field mt-2" name="display_name" maxlength="60" autocomplete="nickname" placeholder="Contributor"/></label>
      <input type="hidden" name="policy_version" value={POLICY_VERSION}/><input id="return-path" type="hidden" name="return_path" value="/account/"/>
      <label class="flex items-start gap-3 leading-7"><input class="mt-2 size-5 shrink-0" type="checkbox" name="accepted_terms" required/><span>I agree to the <a class="text-link" href="/policies/terms/">Terms of Service</a> and <a class="text-link" href="/policies/community/">Community Guidelines</a>, and have read the <a class="text-link" href="/policies/privacy/">Privacy Policy</a>.</span></label>
      <input id="sign-in-token" type="hidden" name="turnstile_token"/><div id="sign-in-challenge"></div><button class="button" type="submit" disabled>Continue with Google</button>
    </form>
    <section id="signed-in" class="mt-8" hidden><p id="account-name" class="text-lg"></p><div class="mt-5 flex flex-wrap gap-5"><button id="sign-out" class="button" type="button">Sign out</button><a id="moderation-link" class="text-link self-center" href="/moderation/" hidden>Review photos and reports</a></div><h2 class="mt-10 text-2xl font-semibold">Your photo submissions</h2><p class="mt-3 text-muted">Showing your 50 most recent submissions. Pending photos are visible only to you and moderators. Comments are not available yet.</p><div id="own-photos" class="mt-6 space-y-6"></div></section>
    <noscript><p class="mt-6">Sign-in and photo submissions require JavaScript. You can browse component specifications without it.</p></noscript>
  </div>
</Layout>
<script>
window.addEventListener('pageshow',event=>{if(event.persisted)location.reload();});
import { api, challenge, element, jsonOptions, message } from '../scripts/community';
const status=document.querySelector<HTMLElement>('#account-message')!;
const form=document.querySelector<HTMLFormElement>('#sign-in-form')!;
try {
  const session=await api('/api/session');
  if(new URL(location.href).searchParams.get('signIn')==='failed')message(status,'Sign-in failed or expired. Please start again.',true);
  if(session.user){
    document.querySelector<HTMLElement>('#signed-in')!.hidden=false;
    document.querySelector('#account-name')!.textContent=`Signed in as ${session.user.displayName}.`;
    if(!new URL(location.href).searchParams.has('signIn'))message(status,'');
    (document.querySelector('#moderation-link') as HTMLElement).hidden=!session.user.moderator;
    document.querySelector('#sign-out')!.addEventListener('click',async()=>{try{await api('/api/auth/logout',jsonOptions({},session.csrfToken));location.assign('/account/');}catch(error){message(status,(error as Error).message,true);}});
    const {photos}=await api('/api/account/photos');const list=document.querySelector('#own-photos')!;
    if(!photos.length)list.append(element('p','text-muted','You have not submitted any photos. Browse a component page to add one.'));
    for(const photo of photos){const article=element('article','panel space-y-3 p-5');article.append(element('h3','text-lg font-semibold',photo.caption),element('p','text-sm text-muted',`Status: ${photo.status}`));if(photo.componentUrl){const component=document.createElement('a');component.className='text-link';component.href=photo.componentUrl;component.textContent=photo.componentModel;article.append(component);}if(photo.reason)article.append(element('p','text-sm',photo.reason));if(photo.previewUrl){const img=document.createElement('img');img.src=photo.previewUrl;img.alt=photo.alt;img.loading='lazy';img.className='max-h-72 w-full rounded-lg object-contain';article.append(img);}if(['pending','approved','blocked','processing'].includes(photo.status)){const remove=element('button','text-link text-sm','Remove this photo') as HTMLButtonElement;remove.type='button';remove.addEventListener('click',async()=>{if(!confirm('Remove this photo from public display? Any legally required private evidence hold will be retained.'))return;remove.disabled=true;try{await api(`/api/photos/${photo.id}`,{method:'DELETE',headers:{'X-CSRF-Token':session.csrfToken}});location.reload();}catch(error){message(status,(error as Error).message,true);remove.disabled=false;}});article.append(remove);}list.append(article);}
  }else if(session.signInAvailable){
    form.hidden=false;if(!new URL(location.href).searchParams.has('signIn'))message(status,'');
    const resetChallenge=await challenge(document.querySelector('#sign-in-challenge')!,session.turnstileSiteKey,'sign-in',document.querySelector('#sign-in-token')!);
    form.querySelector<HTMLButtonElement>('button[type=submit]')!.disabled=false;
    form.addEventListener('submit',async event=>{
      event.preventDefault();if(!form.reportValidity())return;
      if(!(document.querySelector('#sign-in-token') as HTMLInputElement).value){message(status,'Complete the anti-spam check before continuing.',true);return;}
      const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;button.disabled=true;
      try {const options=jsonOptions(Object.fromEntries(new FormData(form)));(options.headers as Record<string,string>).Accept='application/json';const result=await api('/api/auth/google/start',options);location.assign(result.redirectUrl);}
      catch(error){message(status,(error as Error).message,true);resetChallenge();button.disabled=false;}
    });
    const back=new URL(location.href).searchParams.get('returnTo');if(back?.startsWith('/')&&!back.startsWith('//'))(document.querySelector('#return-path') as HTMLInputElement).value=back;
  }else message(status,'Sign-in is not available yet. You can browse the catalogue without an account.');
}catch(error){message(status,(error as Error).message,true);}
</script>
