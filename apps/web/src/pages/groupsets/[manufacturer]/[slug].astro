---
import Layout from '../../../layouts/Layout.astro';
import Sources from '../../../components/Sources.astro';
import ComponentList from '../../../components/ComponentList.astro';
import { groupsets, components, types, manufacturerFor, manufacturerUrl, groupsetName } from '../../../lib/catalogue.mjs';
export function getStaticPaths() { return groupsets.map(groupset=>({params:{manufacturer:manufacturerFor(groupset).slug,slug:groupset.slug},props:{groupset}})); }
const { groupset } = Astro.props;
const manufacturer = manufacturerFor(groupset);
const records = components.filter(c=>c.groupset_ids.includes(groupset.id));
---
<Layout title={`${manufacturer.name} ${groupsetName(groupset)}`}><div class="wrap py-12"><nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted"><a class="text-link" href="/manufacturers/">Manufacturers</a> / <a class="text-link" href={manufacturerUrl(manufacturer)}>{manufacturer.name}</a> / {groupsetName(groupset)}</nav><h1 class="text-5xl tracking-tight">{groupsetName(groupset)}</h1><dl class="mt-7 flex flex-wrap gap-x-10 gap-y-4"><div><dt class="text-sm text-muted">Model number</dt><dd class="mt-2 font-mono">{groupset.model_number}</dd></div><div><dt class="text-sm text-muted">Start year</dt><dd class="mt-2">{groupset.start_year}</dd></div></dl><p class="mt-5 text-muted">{records.length} component{records.length === 1 ? '' : 's'} listed for this groupset. Other parts may not have been added yet.</p><div class="mt-12 grid gap-10 lg:grid-cols-[220px_1fr]"><aside><h2 class="mb-4 text-2xl">Component types</h2><ul class="space-y-3 text-sm">{types.map(t=>{const count=records.filter(c=>c.type===t.const).length; return <li class="flex justify-between gap-4"><a class="text-link" href={`/catalogue/?groupset=${groupset.id}&type=${t.const}`}>{t.title}</a><span class="text-muted">{count || '—'}</span></li>;})}</ul><p class="mt-6 text-xs leading-5 text-muted">— means no component of this type has been added yet.</p></aside><section aria-label="Components"><ComponentList records={records}/><Sources sources={groupset.sources}/></section></div></div></Layout>
