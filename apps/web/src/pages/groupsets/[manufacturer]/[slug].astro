---
import Layout from '../../../layouts/Layout.astro';
import Sources from '../../../components/Sources.astro';
import ComponentList from '../../../components/ComponentList.astro';
import { groupsets, components, types, manufacturerFor, manufacturerUrl, yearRangeLabel } from '../../../lib/catalogue.mjs';
export function getStaticPaths() { return groupsets.map(groupset=>({params:{manufacturer:manufacturerFor(groupset).slug,slug:groupset.slug},props:{groupset}})); }
const { groupset } = Astro.props;
const manufacturer = manufacturerFor(groupset);
const records = components.filter(c=>c.groupset_ids.includes(groupset.id));
---
<Layout title={`${manufacturer.name} ${groupset.name} ${groupset.model_number || ''}`}><div class="wrap py-12"><nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted"><a class="text-link" href="/manufacturers/">Manufacturers</a> / <a class="text-link" href={manufacturerUrl(manufacturer)}>{manufacturer.name}</a> / {groupset.name}</nav><p class="eyebrow mb-4">{manufacturer.name} · {groupset.model_number}</p><h1 class="text-5xl tracking-tight">{groupset.name}</h1><dl class="mt-7 flex flex-wrap gap-x-10 gap-y-4"><div><dt class="eyebrow">Model number</dt><dd class="mt-2 font-mono">{groupset.model_number}</dd></div><div><dt class="eyebrow">Year range</dt><dd class="mt-2">{yearRangeLabel(groupset.year_range)}</dd></div></dl><p class="mt-5 text-muted">{records.length} components catalogued. This is a growing reference, not a complete inventory.</p><div class="mt-12 grid gap-10 lg:grid-cols-[220px_1fr]"><aside><h2 class="eyebrow mb-4">Component types</h2><ul class="space-y-3 text-sm">{types.map(t=>{const count=records.filter(c=>c.type===t.const).length; return <li class="flex justify-between gap-4"><a class="text-link" href={`/catalogue/?groupset=${groupset.id}&type=${t.const}`}>{t.title}</a><span class="text-muted">{count || '—'}</span></li>;})}</ul><p class="mt-6 text-xs leading-5 text-muted">— means not yet catalogued. It does not establish whether a part was offered.</p></aside><section aria-label="Components"><ComponentList records={records}/><Sources sources={groupset.sources}/></section></div></div></Layout>
