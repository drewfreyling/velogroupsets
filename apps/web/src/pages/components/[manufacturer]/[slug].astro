---
import Layout from '../../../layouts/Layout.astro';
import Sources from '../../../components/Sources.astro';
import { components, manufacturerFor, manufacturerUrl, groupsFor, groupsetUrl, typeName } from '../../../lib/catalogue.mjs';
export function getStaticPaths() {
  return components.map(component => ({
    params: { manufacturer: manufacturerFor(component).slug, slug: component.slug },
    props: { component },
  }));
}
const { component } = Astro.props;
const manufacturer = manufacturerFor(component);
const groups = groupsFor(component);
const format = value => value == null ? 'Not documented' : Array.isArray(value) ? value.map(format).join(', ') : String(value);
---
<Layout title={`${manufacturer.name} ${component.name} ${component.model_number}`}>
  <div class="wrap py-12">
    <nav aria-label="Breadcrumb" class="mb-8 flex flex-wrap gap-2 text-sm text-muted">
      <a class="text-link" href="/manufacturers/">Manufacturers</a> /
      <a class="text-link" href={manufacturerUrl(manufacturer)}>{manufacturer.name}</a> /
      {groups.length === 1 && <><a class="text-link" href={groupsetUrl(groups[0])}>{groups[0].name}</a> /</>}
      {component.model_number}
    </nav>
    <p class="eyebrow mb-4">{manufacturer.name} · {typeName(component.type)}</p>
    <h1 class="text-4xl tracking-tight sm:text-5xl">{component.name}</h1>
    <p class="mt-4 font-mono text-lg text-muted">{component.model_number}</p>
    <div class="mt-10 grid gap-10 md:grid-cols-[1fr_320px]">
      <div>
        <h2 class="mb-5 text-2xl">Component details</h2>
        <dl class="divide-y divide-line border-y border-line">
          <div class="grid grid-cols-2 gap-4 py-4"><dt class="text-muted">Model number</dt><dd class="font-mono">{component.model_number}</dd></div>
          <div class="grid grid-cols-2 gap-4 py-4"><dt class="text-muted">Component type</dt><dd>{typeName(component.type)}</dd></div>
          <div class="grid grid-cols-2 gap-4 py-4">
            <dt class="text-muted">Weight</dt>
            <dd><span class="font-semibold">{component.weight_g} g</span><p class="mt-2 text-sm leading-6 text-muted">{component.weight_description}</p>{component.weight_excludes_skewers && <p class="mt-2 text-sm font-semibold">Excludes skewers.</p>}</dd>
          </div>
          <div class="grid grid-cols-2 gap-4 py-4"><dt class="text-muted">Technical specification</dt><dd><a class="text-link" href={component.technical_document.url}>Read {manufacturer.name} technical specification</a><p class="mt-2 text-sm leading-6 text-muted">{component.technical_document.title}</p></dd></div>
          <div class="grid grid-cols-2 gap-4 py-4"><dt class="text-muted">Groupset membership</dt><dd class="space-y-2">{groups.map(g => <p><a class="text-link" href={groupsetUrl(g)}>{g.name} {g.model_number}</a></p>)}</dd></div>
          {Object.entries(component.specifications || {}).map(([key, value]) => <div class="grid grid-cols-2 gap-4 py-4"><dt class="text-muted">{key.replaceAll('_', ' ')}</dt><dd>{format(value)}</dd></div>)}
        </dl>
        <Sources sources={component.sources}/>
      </div>
      <aside class="panel self-start p-7">
        <p class="eyebrow mb-4">Photos and corrections</p>
        <h2 class="text-2xl">Component photos and comments</h2>
        <p class="mt-4 text-sm leading-7 text-muted">Photo uploads and comments are not available yet. Corrections to component specifications can be submitted through GitHub.</p>
        <a class="text-link mt-6 inline-block text-sm" href={`https://github.com/drewfreyling/velogroupsets/edit/main/data/components/${component.id}.json`}>Edit this component on GitHub</a>
        <p class="mt-6 break-all font-mono text-[10px] text-muted">Reference ID: {component.id}</p>
      </aside>
    </div>
  </div>
</Layout>
