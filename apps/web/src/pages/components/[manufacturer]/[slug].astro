---
import ExternalLink from '../../../components/ExternalLink.astro';
import Layout from '../../../layouts/Layout.astro';
import Sources from '../../../components/Sources.astro';
import PhotoGallery from '../../../components/PhotoGallery.astro';
import DerailleurCageHelp from '../../../components/DerailleurCageHelp.astro';
import { components, manufacturerFor, manufacturerUrl, groupsFor, groupsetUrl, groupsetName, typeName } from '../../../lib/catalogue.mjs';
export function getStaticPaths() {
  return components.map(component => ({
    params: { manufacturer: manufacturerFor(component).slug, slug: component.slug },
    props: { component },
  }));
}
const { component } = Astro.props;
const manufacturer = manufacturerFor(component);
const groups = groupsFor(component);
const rearDerailleur = component.type === 'rear-derailleur';
const brakeCaliper = component.type === 'brake-calipers';
const brakeBasis = { Pair: 'Front and rear pair', Front: 'Front caliper', Rear: 'Rear caliper' }[component.specifications?.weight_basis];
const limits = [
  ['total_capacity_teeth', 'Total capacity'],
  ['maximum_sprocket_teeth', 'Largest sprocket'],
  ['minimum_sprocket_teeth', 'Smallest sprocket'],
  ['maximum_front_difference_teeth', 'Front chainring tooth difference'],
];
const displayedKeys = new Set(rearDerailleur ? ['cage', ...limits.map(([key]) => key)] : []);
if (brakeCaliper) for (const key of ['weight_basis', 'includes_brake_pads', 'includes_mounting_bolts']) displayedKeys.add(key);
const format = value => value == null ? 'Not documented' : Array.isArray(value) ? value.map(format).join(', ') : String(value);
---
<Layout title={`${manufacturer.name} ${component.model_number} · ${component.name}`}>
  <div class="wrap py-12">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="text-link" href="/manufacturers/">Manufacturers</a></li>
        <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="text-link" href={manufacturerUrl(manufacturer)}>{manufacturer.name}</a></li>
        {groups.length === 1 && <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="text-link" href={groupsetUrl(groups[0])}>{groupsetName(groups[0])}</a></li>}
        <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span aria-current="page">{component.model_number}</span></li>
      </ol>
    </nav>
    <h1 class="break-words font-mono text-4xl font-medium tracking-tight sm:text-5xl">{component.model_number}</h1>
    <p class="mt-3 text-lg text-muted">{component.name}</p>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div>
        <h2 class="mb-5 text-2xl">Component details</h2>
        <dl class="divide-y divide-line border-y border-line">
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Component type</dt><dd><a class="text-link" href={`/catalogue/?type=${component.type}`}>{typeName(component.type)}</a></dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5">
            <dt class="text-sm text-muted">Weight</dt>
            <dd><span class="font-semibold">{component.weight_g === null ? 'Not yet sourced' : `${component.weight_g} g`}</span><p class="mt-2 text-sm leading-6 text-muted">{component.weight_description}</p>{component.weight_excludes_skewers && <p class="mt-2 text-sm font-semibold">{component.weight_g === null ? 'Any weight added must exclude skewers.' : 'Excludes skewers.'}</p>}</dd>
          </div>
          {rearDerailleur && <>
            <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Cage code</dt><dd class="relative">{component.specifications.cage || 'Not yet sourced'}<DerailleurCageHelp /></dd></div>
            {limits.map(([key, label]) => <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">{label}</dt><dd>{component.specifications[key] == null ? 'Not yet sourced' : `${component.specifications[key]}T`}</dd></div>)}
          </>}
          {brakeCaliper && <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Weight basis</dt><dd>{brakeBasis}{component.specifications.includes_brake_pads === true && component.specifications.includes_mounting_bolts === true && <p class="mt-2 text-sm text-muted">Includes brake pads and mounting bolts.</p>}</dd></div>}
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Technical specification</dt><dd><ExternalLink class="text-link" href={component.technical_document.url}>Read {manufacturer.name} technical specification</ExternalLink><p class="mt-2 text-sm leading-6 text-muted">{component.technical_document.title}</p></dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Groupset membership</dt><dd class="space-y-2">{groups.map(g => <p><a class="text-link" href={groupsetUrl(g)}>{groupsetName(g)}</a></p>)}</dd></div>
          {Object.entries(component.specifications || {}).filter(([key]) => !displayedKeys.has(key)).map(([key, value]) => <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">{key.replaceAll('_', ' ')}</dt><dd>{format(value)}</dd></div>)}
        </dl>
        <Sources sources={component.sources}/>
      </div>
      <aside class="self-start space-y-6">
        <PhotoGallery componentId={component.id}/>
        <div class="panel p-7"><h2 class="text-xl">Correct a specification</h2><p class="mt-3 text-sm leading-7 text-muted">Catalogue corrections are reviewed through GitHub.</p><ExternalLink class="text-link mt-4 inline-block text-sm" href={`https://github.com/drewfreyling/velogroupsets/edit/main/data/components/${component.id}.json`}>Edit this component on GitHub</ExternalLink></div>
      </aside>
    </div>
  </div>
</Layout>
