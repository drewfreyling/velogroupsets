---
import Layout from '../../../layouts/Layout.astro';
import Sources from '../../../components/Sources.astro';
import { components, manufacturerFor, manufacturerUrl, groupsFor, groupsetUrl, groupsetName, typeName } from '../../../lib/catalogue.mjs';
export function getStaticPaths() {
  return components.map(component => ({
    params: { manufacturer: manufacturerFor(component).slug, slug: component.slug },
    props: { component },
  }));
}
const { component } = Astro.props;
const manufacturer = manufacturerFor(component);
const groups = groupsFor(component);
const format = value => value == null ? 'Not documented' : Array.isArray(value) ? value.map(format).join(', ') : String(value);
---
<Layout title={`${manufacturer.name} ${component.model_number} · ${component.name}`}>
  <div class="wrap py-12">
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="text-link" href="/manufacturers/">Manufacturers</a></li>
        <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="text-link" href={manufacturerUrl(manufacturer)}>{manufacturer.name}</a></li>
        {groups.length === 1 && <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="text-link" href={groupsetUrl(groups[0])}>{groupsetName(groups[0])}</a></li>}
        <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span aria-current="page">{component.model_number}</span></li>
      </ol>
    </nav>
    <h1 class="break-words font-mono text-4xl font-medium tracking-tight sm:text-5xl">{component.model_number}</h1>
    <p class="mt-3 text-lg text-muted">{component.name}</p>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div>
        <h2 class="mb-5 text-2xl">Component details</h2>
        <dl class="divide-y divide-line border-y border-line">
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Component type</dt><dd><a class="text-link" href={`/catalogue/?type=${component.type}`}>{typeName(component.type)}</a></dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5">
            <dt class="text-sm text-muted">Weight</dt>
            <dd><span class="font-semibold">{component.weight_g} g</span><p class="mt-2 text-sm leading-6 text-muted">{component.weight_description}</p>{component.weight_excludes_skewers && <p class="mt-2 text-sm font-semibold">Excludes skewers.</p>}</dd>
          </div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Technical specification</dt><dd><a class="text-link" href={component.technical_document.url}>Read {manufacturer.name} technical specification</a><p class="mt-2 text-sm leading-6 text-muted">{component.technical_document.title}</p></dd></div>
          <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">Groupset membership</dt><dd class="space-y-2">{groups.map(g => <p><a class="text-link" href={groupsetUrl(g)}>{groupsetName(g)}</a></p>)}</dd></div>
          {Object.entries(component.specifications || {}).map(([key, value]) => <div class="grid gap-1 py-4 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-5"><dt class="text-sm text-muted">{key.replaceAll('_', ' ')}</dt><dd>{format(value)}</dd></div>)}
        </dl>
        <Sources sources={component.sources}/>
      </div>
      <aside class="panel self-start p-7">
        <h2 class="text-2xl">Component photos and comments</h2>
        <p class="mt-4 text-sm leading-7 text-muted">Photo uploads and comments are not available yet. Corrections to component specifications can be submitted through GitHub.</p>
        <a class="text-link mt-6 inline-block text-sm" href={`https://github.com/drewfreyling/velogroupsets/edit/main/data/components/${component.id}.json`}>Edit this component on GitHub</a>
      </aside>
    </div>
  </div>
</Layout>
