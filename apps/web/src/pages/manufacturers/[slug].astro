---
import Layout from '../../layouts/Layout.astro';
import Sources from '../../components/Sources.astro';
import { manufacturers, groupsets, components, groupsetUrl, groupsetName, yearRangeLabel } from '../../lib/catalogue.mjs';
export function getStaticPaths() { return manufacturers.map(manufacturer=>({params:{slug:manufacturer.slug},props:{manufacturer}})); }
const { manufacturer } = Astro.props;
const records = groupsets.filter(g=>g.manufacturer_id===manufacturer.id);
---
<Layout title={manufacturer.name}><div class="wrap py-12"><nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted"><a class="text-link" href="/manufacturers/">Manufacturers</a> / {manufacturer.name}</nav><h1 class="text-5xl tracking-tight">{manufacturer.name}</h1><h2 class="mt-12 mb-5 text-2xl">Groupsets</h2><div class="grid gap-4 sm:grid-cols-3">{records.map(g=><a class="panel group p-7" href={groupsetUrl(g)}><h3 class="mt-3 text-2xl font-semibold group-hover:underline">{groupsetName(g)} </h3><p class="mt-3 text-sm text-muted">{yearRangeLabel(g.year_range)}</p><p class="mt-4 text-sm text-muted">{components.filter(c=>c.groupset_ids.includes(g.id)).length} component{components.filter(c=>c.groupset_ids.includes(g.id)).length === 1 ? '' : 's'} catalogued</p></a>)}</div>{!records.length && <p class="panel p-7 text-muted">No groupsets catalogued yet.</p>}<Sources sources={manufacturer.sources}/></div></Layout>
