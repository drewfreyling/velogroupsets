---
import Layout from '../../layouts/Layout.astro';
import Sources from '../../components/Sources.astro';
import { manufacturers, groupsets, components, categories, categoryName, groupsetUrl, groupsetName } from '../../lib/catalogue.mjs';
export function getStaticPaths() { return manufacturers.map(manufacturer=>({params:{slug:manufacturer.slug},props:{manufacturer}})); }
const { manufacturer } = Astro.props;
const records = groupsets.filter(g=>g.manufacturer_id===manufacturer.id)
  .sort((a,b)=>a.start_year-b.start_year || groupsetName(a).localeCompare(groupsetName(b), 'en', {numeric:true}) || a.id.localeCompare(b.id));
---
<Layout title={manufacturer.name}><div class="wrap py-12">
  <nav aria-label="Breadcrumb" class="mb-8 text-sm text-muted"><a class="text-link" href="/manufacturers/">Manufacturers</a> / {manufacturer.name}</nav>
  <h1 class="text-5xl tracking-tight">{manufacturer.name}</h1>
  <h2 class="mt-12 mb-5 text-2xl">Groupsets</h2>
  <form id="groupset-filters" class="mb-6 flex flex-wrap items-end gap-4">
    <label class="text-sm font-semibold">Riding category<select id="groupset-category" name="category" class="mt-2 block w-full rounded-lg border bg-surface px-3 py-3 text-base font-normal"><option value="">All riding categories</option>{categories.map(c=><option value={c.const}>{c.title}</option>)}</select></label>
    <button type="submit" class="button">Filter groupsets</button>
  </form>
  <p id="groupset-count" role="status" aria-live="polite" class="mb-5 text-sm text-muted">{records.length} groupset{records.length===1?'':'s'}</p>
  <div class="grid gap-4 sm:grid-cols-3">{records.map(g=><a class="panel group p-7" data-groupset-category={g.category} href={groupsetUrl(g)}><h3 class="mt-3 text-2xl font-semibold group-hover:underline">{groupsetName(g)}</h3><p class="mt-3 text-sm text-muted">{categoryName(g.category)}</p><p class="mt-3 text-sm text-muted">Start year: {g.start_year}</p><p class="mt-4 text-sm text-muted">{components.filter(c=>c.groupset_ids.includes(g.id)).length} component{components.filter(c=>c.groupset_ids.includes(g.id)).length===1?'':'s'} catalogued</p></a>)}</div>
  <div id="groupset-empty" class="panel p-7" hidden><p class="text-muted">No groupsets in this riding category have been catalogued for {manufacturer.name}.</p><button type="button" id="groupset-reset" class="button mt-4">Show all groupsets</button></div>
  <noscript><p class="mt-6 text-muted">All groupsets are listed above. Enable JavaScript to filter by riding category.</p></noscript>
  <Sources sources={manufacturer.sources}/>
</div></Layout>
<script>
  const form=document.querySelector<HTMLFormElement>('#groupset-filters')!;
  const select=document.querySelector<HTMLSelectElement>('#groupset-category')!;
  const cards=[...document.querySelectorAll<HTMLElement>('[data-groupset-category]')];
  function filter(updateUrl=true) {
    let count=0;
    for(const card of cards){card.hidden=Boolean(select.value&&card.dataset.groupsetCategory!==select.value);if(!card.hidden)count++;}
    document.querySelector('#groupset-count')!.textContent=`${count} groupset${count===1?'':'s'}`;
    document.querySelector<HTMLElement>('#groupset-empty')!.hidden=count>0;
    if(updateUrl){const p=new URLSearchParams(location.search);if(select.value)p.set('category',select.value);else p.delete('category');history.replaceState(null,'',`${location.pathname}${p.size?'?'+p:''}`);}
  }
  function restore(){select.value=new URLSearchParams(location.search).get('category')||'';filter(false);}
  restore();
  select.addEventListener('change',()=>filter());
  form.addEventListener('submit',event=>{event.preventDefault();filter();});
  document.querySelector('#groupset-reset')!.addEventListener('click',()=>{select.value='';filter();select.focus();});
  window.addEventListener('popstate',restore);
</script>
