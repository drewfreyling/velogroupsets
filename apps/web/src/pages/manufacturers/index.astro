---
import Layout from '../../layouts/Layout.astro';
import { manufacturers, groupsets, manufacturerUrl } from '../../lib/catalogue.mjs';
---
<Layout title="Manufacturers"><div class="wrap py-12"><p class="eyebrow mb-4">The catalogue</p><h1 class="text-5xl tracking-tight">Manufacturers</h1><p class="mt-5 max-w-xl leading-7 text-muted">Start with the brand, explore a groupset, then get to know each component. This collection is just getting started.</p><div class="mt-10 grid gap-4 sm:grid-cols-3">{manufacturers.map(m=><a class="panel group p-7" href={manufacturerUrl(m)}><h2 class="text-2xl font-semibold group-hover:underline">{m.name} <svg class="inline-block size-4 shrink-0 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></h2><p class="mt-3 text-sm text-muted">{groupsets.filter(g=>g.manufacturer_id===m.id).length} groupset catalogued</p></a>)}</div></div></Layout>
