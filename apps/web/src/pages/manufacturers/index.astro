---
import Layout from '../../layouts/Layout.astro';
import { manufacturers, groupsets, manufacturerUrl } from '../../lib/catalogue.mjs';
---
<Layout title="Manufacturers"><div class="wrap py-12"><h1 class="text-5xl tracking-tight">Manufacturers</h1><p class="mt-5 max-w-xl leading-7 text-muted">Choose a manufacturer to see its groupsets and their component specifications.</p><div class="mt-10 grid gap-4 sm:grid-cols-3">{manufacturers.map(m=><a class="panel group p-7" href={manufacturerUrl(m)}><h2 class="text-2xl font-semibold group-hover:underline">{m.name} </h2><p class="mt-3 text-sm text-muted">{groupsets.filter(g=>g.manufacturer_id===m.id).length} groupset{groupsets.filter(g=>g.manufacturer_id===m.id).length === 1 ? '' : 's'} catalogued</p><p class="mt-4 text-sm font-semibold">See {m.name} groupsets</p></a>)}</div></div></Layout>
