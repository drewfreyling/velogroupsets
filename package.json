{
  "name": "velogroupsets",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "scripts": {
    "dev": "astro dev --root apps/web --host 0.0.0.0",
    "build": "astro build --root apps/web",
    "preview": "astro preview --root apps/web --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "worker:dev": "wrangler dev --config wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config wrangler.jsonc --outdir /tmp/velogroupsets-worker"
  },
  "dependencies": { "astro": "7.4.7", "tailwindcss": "4.3.5", "@tailwindcss/vite": "4.3.5" },
  "devDependencies": { "wrangler": "4.158.0", "@playwright/test": "1.65.0" }
}
