{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velogroupsets.com/schemas/catalogue.schema.json",
  "title": "VeloGroupsets catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manufacturers",
    "groupsets",
    "components"
  ],
  "properties": {
    "manufacturers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manufacturer"
      }
    },
    "groupsets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groupset"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "url",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "retrieved_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "manufacturer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "website_url": {
          "$ref": "#/$defs/https_url"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "sources",
        "website_url"
      ],
      "additionalProperties": false
    },
    "groupset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "manufacturer_id": {
          "$ref": "#/$defs/id"
        },
        "generation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_number": {
          "$ref": "#/$defs/text"
        },
        "year_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/year"
            },
            "end": {
              "anyOf": [
                {
                  "$ref": "#/$defs/year"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "sources",
        "manufacturer_id",
        "model_number",
        "year_range"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "manufacturer_id": {
          "$ref": "#/$defs/id"
        },
        "groupset_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "$ref": "https://velogroupsets.com/schemas/component-type.schema.json"
        },
        "specifications": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "not": {
              "enum": [
                "weight_g",
                "model_code",
                "model_number",
                "technical_document",
                "year_range",
                "weight_description",
                "weight_excludes_skewers"
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            ]
          }
        },
        "model_number": {
          "$ref": "#/$defs/text"
        },
        "weight_g": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "description": "Positive weight in grams; rear hubs may use null until a weight without skewers is sourced."
        },
        "technical_document": {
          "$ref": "#/$defs/technical_document"
        },
        "weight_description": {
          "$ref": "#/$defs/text"
        },
        "weight_excludes_skewers": {
          "type": "boolean",
          "const": true,
          "description": "Required for front/rear hubs; weights must exclude skewers."
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "sources",
        "manufacturer_id",
        "groupset_ids",
        "type",
        "model_number",
        "weight_g",
        "technical_document",
        "weight_description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {"const": "rear-hub"}
            }
          },
          "else": {
            "properties": {
              "weight_g": {"type": "number"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "front-hub",
                  "rear-hub"
                ]
              }
            }
          },
          "then": {
            "required": [
              "weight_excludes_skewers"
            ]
          },
          "else": {
            "not": {
              "required": [
                "weight_excludes_skewers"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rear-derailleur"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "required": [
                  "total_capacity_teeth",
                  "maximum_sprocket_teeth",
                  "minimum_sprocket_teeth",
                  "maximum_front_difference_teeth"
                ],
                "properties": {
                  "total_capacity_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "maximum_sprocket_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "minimum_sprocket_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "maximum_front_difference_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "technical_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    }
  }
}
