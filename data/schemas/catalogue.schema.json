{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velogroupsets.com/schemas/catalogue.schema.json",
  "title": "VeloGroupsets catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manufacturers",
    "groupsets",
    "components"
  ],
  "properties": {
    "manufacturers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manufacturer"
      }
    },
    "groupsets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/groupset"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "url",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "retrieved_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "manufacturer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "website_url": {
          "$ref": "#/$defs/https_url"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "sources",
        "website_url"
      ],
      "additionalProperties": false
    },
    "groupset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "manufacturer_id": {
          "$ref": "#/$defs/id"
        },
        "generation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model_number": {
          "$ref": "#/$defs/text"
        },
        "start_year": {
          "$ref": "#/$defs/year"
        },
        "category": {
          "$ref": "#/$defs/groupset_category"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "sources",
        "manufacturer_id",
        "model_number",
        "start_year",
        "category"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "manufacturer_id": {
          "$ref": "#/$defs/id"
        },
        "groupset_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "$ref": "https://velogroupsets.com/schemas/component-type.schema.json"
        },
        "specifications": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "not": {
              "enum": [
                "weight_g",
                "model_code",
                "model_number",
                "technical_document",
                "start_year",
                "weight_description",
                "weight_excludes_skewers"
              ]
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            ]
          }
        },
        "model_number": {
          "$ref": "#/$defs/text"
        },
        "weight_g": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "Positive weight in grams for a compliant identified configuration, or explicit null when no compliant weight is sourced."
        },
        "technical_document": {
          "description": "Manufacturer technical document when available; explicit null when no matching document is linked. Component identity and facts still require source citations.",
          "anyOf": [
            {
              "$ref": "#/$defs/technical_document"
            },
            {
              "type": "null"
            }
          ]
        },
        "weight_description": {
          "$ref": "#/$defs/text"
        },
        "weight_excludes_skewers": {
          "type": "boolean",
          "const": true,
          "description": "Required for front/rear hubs; weights must exclude skewers."
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Reserved previous component IDs and slugs merged into this canonical record.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "slug"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "slug": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "sources",
        "manufacturer_id",
        "groupset_ids",
        "type",
        "model_number",
        "weight_g",
        "technical_document",
        "weight_description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "front-hub",
                  "rear-hub"
                ]
              }
            }
          },
          "then": {
            "required": [
              "weight_excludes_skewers"
            ]
          },
          "else": {
            "not": {
              "required": [
                "weight_excludes_skewers"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rear-derailleur"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "required": [
                  "total_capacity_teeth",
                  "maximum_sprocket_teeth",
                  "minimum_sprocket_teeth",
                  "maximum_front_difference_teeth"
                ],
                "properties": {
                  "total_capacity_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "maximum_sprocket_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "minimum_sprocket_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "maximum_front_difference_teeth": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "shifters"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "oneOf": [
                  {
                    "required": [
                      "weight_basis"
                    ],
                    "properties": {
                      "weight_basis": {
                        "const": "Pair"
                      }
                    },
                    "description": "Complete left/right control set, including sets with a brake-only left unit."
                  },
                  {
                    "required": [
                      "weight_basis",
                      "control_side",
                      "front_speeds",
                      "rear_speeds"
                    ],
                    "properties": {
                      "weight_basis": {
                        "const": "Single"
                      },
                      "control_side": {
                        "const": "Right"
                      },
                      "front_speeds": {
                        "const": 1
                      },
                      "rear_speeds": {
                        "type": "integer",
                        "minimum": 2
                      }
                    },
                    "description": "One complete right-hand rear-shift control for a 1× drivetrain; ambidextrous hardware requires a documented right-hand configuration."
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "brake-calipers"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "required": [
                  "weight_basis"
                ],
                "properties": {
                  "weight_basis": {
                    "enum": [
                      "Pair",
                      "Front",
                      "Rear"
                    ]
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "weight_g": {
                      "type": "number"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "specifications": {
                      "required": [
                        "includes_brake_pads",
                        "includes_mounting_bolts"
                      ],
                      "properties": {
                        "includes_brake_pads": {
                          "const": true
                        },
                        "includes_mounting_bolts": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "disc-brake-caliper"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "required": [
                  "weight_basis",
                  "actuation",
                  "mount",
                  "piston_count"
                ],
                "properties": {
                  "weight_basis": {
                    "enum": [
                      "Single",
                      "Front",
                      "Rear",
                      "Pair"
                    ]
                  },
                  "actuation": {
                    "enum": [
                      "Hydraulic",
                      "Mechanical"
                    ]
                  },
                  "mount": {
                    "enum": [
                      "Post mount",
                      "Flat mount",
                      "International Standard"
                    ]
                  },
                  "piston_count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "disc-brake-rotor"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "required": [
                  "weight_basis",
                  "diameter_mm",
                  "mount"
                ],
                "properties": {
                  "weight_basis": {
                    "const": "Single"
                  },
                  "diameter_mm": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mount": {
                    "enum": [
                      "Center Lock",
                      "6-bolt"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "disc-brake-system"
              }
            }
          },
          "then": {
            "required": [
              "specifications"
            ],
            "properties": {
              "specifications": {
                "required": [
                  "weight_basis",
                  "actuation",
                  "position",
                  "lever_model",
                  "caliper_model",
                  "lever_side",
                  "hose_model",
                  "hose_length_mm",
                  "includes_rotor"
                ],
                "properties": {
                  "weight_basis": {
                    "const": "Single"
                  },
                  "actuation": {
                    "const": "Hydraulic"
                  },
                  "position": {
                    "enum": [
                      "Front",
                      "Rear"
                    ]
                  },
                  "lever_model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caliper_model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lever_side": {
                    "enum": [
                      "Left",
                      "Right",
                      null
                    ]
                  },
                  "hose_model": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "hose_length_mm": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "includes_rotor": {
                    "enum": [
                      true,
                      false,
                      null
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "technical_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "retrieved_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2100
    },
    "groupset_category": {
      "title": "Groupset category",
      "description": "Primary manufacturer range: riding category, separate from component type.",
      "oneOf": [
        {
          "const": "road",
          "title": "Road"
        },
        {
          "const": "mtb",
          "title": "MTB"
        },
        {
          "const": "gravel",
          "title": "Gravel"
        },
        {
          "const": "track",
          "title": "Track"
        }
      ]
    }
  }
}
